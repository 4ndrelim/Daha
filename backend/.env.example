# Your copy is backend/.env (gitignored, never commit it): run `make env` to create it, and again
# after a pull to pick up new variables (it keeps your values). PLAN.md §5.3.
# --- core (A) ---
DATABASE_URL=postgresql+psycopg://daha:daha@localhost:5432/daha
TEST_DATABASE_URL=postgresql+psycopg://daha:daha@localhost:5432/daha_test
JWT_SECRET=change-me                 # human: replace with output of `openssl rand -hex 32`
ALLOWED_EMAIL_DOMAINS=stanford.edu
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
CAMPUS_TZ=America/Los_Angeles
CORS_ORIGINS=http://localhost:3000
# --- AI & discovery (C) ---
AI_PROVIDER=harnessrouter            # harnessrouter (real photo AI, needs the keys below) | mock (free, fake) | anthropic
AI_MOCK_LATENCY_MS=2500
AI_MAX_IMAGES_PER_SCAN=6
AI_DAILY_SCANS_PER_USER=20
AI_BUDGET_USD=40                     # hard stop for paid vision calls (keeps $10 of $50 for evals)
# HarnessRouter key(s) (sk-hr-…, never commit). Several keys? Comma-separated, no spaces:
# sk-hr-aaa,sk-hr-bbb. Photos are load-balanced across them, and a key that's out of credit or
# rate-limited is skipped. After changing keys: uv run python scripts/setup_harnessrouter.py --write-env
HARNESSROUTER_API_KEY=
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HARNESSROUTER_VISION_HARNESS_ID=     # set by setup_harnessrouter.py --write-env: one id per key, same order
HARNESSROUTER_BASE=claude-code       # harness base chosen in the C0 spike
HARNESSROUTER_MODEL=                 # model id chosen in the C0 spike (from GET /v1/models)
HARNESSROUTER_MAX_CONCURRENCY=4      # tasks at once, all keys together (free trial: 2 per organization; our 2 keys = 2 orgs)
HARNESSROUTER_TIMEOUT_S=180
HARNESSROUTER_EST_COST_PER_IMAGE=0.10   # from the spike; used when the API reports no cost
ANTHROPIC_API_KEY=                   # optional fallback provider
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
EMBEDDINGS_PROVIDER=fastembed        # fastembed | hash (tests/CI)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MATCH_MIN_SCORE=0.55                 # calibrated by C on seed data
AI_ENRICH_REQUESTS=false
# --- buy or rent nearby (C6): store/rental alternatives from Exa web search ---
COMMERCIAL_PROVIDER=exa              # exa (real stores; needs EXA_API_KEY) | mock (free sample data) | off
EXA_API_KEY=                         # human (Andre): from dashboard.exa.ai — never commit
EXA_BASE_URL=https://api.exa.ai
EXA_SEARCH_TYPE=auto                 # auto (~$0.007/search + $0.001/page summary) | deep (slower)
COMMERCIAL_CACHE_HOURS=24            # same words + same area within this window = free
COMMERCIAL_DAILY_LOOKUPS_PER_USER=25 # uncached lookups per person per 24 h
COMMERCIAL_BUDGET_USD=9              # hard stop per calendar month (Exa's free tier is $10/month)
COMMERCIAL_EST_COST_USD=0.017        # per uncached lookup when Exa reports no cost
COMMERCIAL_DEFAULT_PLACE=Stanford, CA   # campus: used when the phone's location isn't shared (plans/LOCATION.md)
COMMERCIAL_DEFAULT_LABEL=Stanford campus   # how that fallback is named in the app ("Near Stanford campus")
COMMERCIAL_DEFAULT_LAT=37.4275
COMMERCIAL_DEFAULT_LNG=-122.1697
