# Your copy is backend/.env (gitignored, never commit it): run `make env` to create it, and again
# after a pull to pick up new variables (it keeps your values). PLAN.md §5.3.
# An empty value gets its comment on the line above, never after it: Docker reads `KEY=  # note`
# as the text "# note" (the backend ignores such values, but keep the file clean).
# --- core (A) ---
DATABASE_URL=postgresql+psycopg://daha:daha@localhost:5432/daha
TEST_DATABASE_URL=postgresql+psycopg://daha:daha@localhost:5432/daha_test
JWT_SECRET=change-me                 # human: replace with output of `openssl rand -hex 32`
ALLOWED_EMAIL_DOMAINS=stanford.edu
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
CAMPUS_TZ=America/Los_Angeles
CORS_ORIGINS=http://localhost:3000
# --- AI & discovery (C) ---
AI_PROVIDER=harnessrouter            # harnessrouter (real photo AI, needs the keys below) | mock (free, fake) | anthropic
AI_MOCK_LATENCY_MS=2500
AI_MAX_IMAGES_PER_SCAN=6
AI_DAILY_SCANS_PER_USER=20
AI_BUDGET_USD=40                     # hard stop for paid vision calls (keeps $10 of $50 for evals)
# Adding a key later: put it at the end, run `uv run python scripts/setup_harnessrouter.py --all
# --missing --write-env` (harnesses for the new key only) and `--smoke --yes` (one tiny paid photo
# per key), then deploy. A key without harness ids is skipped, never an error.
# HarnessRouter key(s) (sk-hr-…, never commit). Several keys? Comma-separated, no spaces:
# sk-hr-aaa,sk-hr-bbb. Photos are load-balanced across them, and a key that's out of credit or
# rate-limited is skipped. After changing keys: uv run python scripts/setup_harnessrouter.py --write-env
HARNESSROUTER_API_KEY=
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
# Set by setup_harnessrouter.py --write-env: one id per key, same order
HARNESSROUTER_VISION_HARNESS_ID=
HARNESSROUTER_BASE=claude-code       # harness base chosen in the C0 spike
# Model and reasoning effort for every harness the setup script creates (docs/ai-spike.md:
# Opus 5.5 at low effort was the most accurate without being slower; medium/high added 7-11 s).
# Changing either means new harnesses: run setup_harnessrouter.py --write-env again.
HARNESSROUTER_MODEL=claude-opus-5.5
HARNESSROUTER_REASONING_EFFORT=low
# Race each photo on two keys when a task slot is free; the first answer wins (steadier ~12-14 s,
# about twice the cost). On for the live server only: laptops would take the shared slots.
HARNESSROUTER_RACE=false
# Slots on key 1 that photos leave free for the coordinator, condition check and profiles (they
# always use key 1). -1 = auto: 1 with 2 keys, all of key 1 with 3 or more.
HARNESSROUTER_AGENT_SLOTS=-1
HARNESSROUTER_TASKS_PER_KEY=2        # HarnessRouter's limit per organization (each key is one; free plan: 2)
HARNESSROUTER_MAX_CONCURRENCY=0      # tasks at once, all keys together; 0 = tasks per key x keys
HARNESSROUTER_TIMEOUT_S=180
HARNESSROUTER_EST_COST_PER_IMAGE=0.10   # from the spike; used when the API reports no cost
# Mutual matching, "You two can help each other" (docs/plans/mutual-matching.md)
MUTUAL_MATCHING=off                  # off (hidden) | rules (free, no AI) | ai (rules + HarnessRouter habit profiles, paid)
MUTUAL_BUDGET_USD=3                  # hard stop for paid profile tasks; comes out of the AI_BUDGET_USD total
MUTUAL_EST_COST_PER_PROFILE=0.05     # used when the API reports no cost
# Set by setup_harnessrouter.py --profile --write-env: one id per key, same order
HARNESSROUTER_PROFILE_HARNESS_ID=
# Condition check: lender + borrower photograph a lent item at handoff and return; an AI compares them.
CONDITION_CHECK_ENABLED=false        # true = show it (web also needs NEXT_PUBLIC_CONDITION_CHECK=true). With AI_PROVIDER=mock it gives a labeled sample result
# Set by setup_harnessrouter.py --condition --write-env: one id per key, same order
HARNESSROUTER_CONDITION_HARNESS_ID=
CONDITION_BUDGET_USD=2               # hard stop for paid condition checks (a few cents each)
CONDITION_EST_COST_PER_CHECK=0.05    # used when the API reports no cost
# Handoff coordinator: "Suggest a time & place" in a transaction's chat (docs/plans/handoff-coordinator.md)
HANDOFF_COORDINATOR_ENABLED=false    # true = show it (web also needs NEXT_PUBLIC_HANDOFF_COORDINATOR=true). With AI_PROVIDER=mock it gives a labeled sample
# Set by setup_harnessrouter.py --handoff --write-env: one id per key, same order
HARNESSROUTER_HANDOFF_HARNESS_ID=
# The model for that harness (dsh base), e.g. claude-haiku-5.5; set it before running the setup script
HARNESSROUTER_HANDOFF_MODEL=
HANDOFF_BUDGET_USD=1                 # hard stop for paid suggestions
HANDOFF_EST_COST_PER_RUN=0.02        # used when the API reports no cost
# Optional fallback provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
EMBEDDINGS_PROVIDER=fastembed        # fastembed | hash (tests/CI)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MATCH_MIN_SCORE=0.55                 # calibrated by C on seed data
AI_ENRICH_REQUESTS=false
# --- buy or rent nearby (C6): store/rental alternatives from Exa web search ---
COMMERCIAL_PROVIDER=exa              # exa (real stores; needs EXA_API_KEY) | mock (free sample data) | off
# Human (Andre): from dashboard.exa.ai — never commit
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_SEARCH_TYPE=auto                 # auto (~$0.007/search + $0.001/page summary) | deep (slower)
COMMERCIAL_CACHE_HOURS=24            # same words + same area within this window = free
COMMERCIAL_DAILY_LOOKUPS_PER_USER=25 # uncached lookups per person per 24 h
COMMERCIAL_BUDGET_USD=9              # hard stop per calendar month (Exa's free tier is $10/month)
COMMERCIAL_EST_COST_USD=0.017        # per uncached lookup when Exa reports no cost
COMMERCIAL_DEFAULT_PLACE=Stanford, CA   # campus: used when the phone's location isn't shared (plans/LOCATION.md)
COMMERCIAL_DEFAULT_LABEL=Stanford campus   # how that fallback is named in the app ("Near Stanford campus")
COMMERCIAL_DEFAULT_LAT=37.4275
COMMERCIAL_DEFAULT_LNG=-122.1697
