# Settings for infra/deploy/deploy.sh. Copy to infra/deploy/.env (gitignored) and fill in.
# Your API keys are NOT here: the script takes them from your own backend/.env.

# How to SSH into the VM: <user>@<public IP> (Azure portal → your VM → Overview → Public IP address)
VM=azureuser@0.0.0.0
# The private key file, if it isn't your default (~/.ssh/id_ed25519 or id_rsa). Example for the key
# Azure lets you download: SSH_KEY=~/Downloads/daha-vm_key.pem   (then run: chmod 600 on that file)
SSH_KEY=

# The free web address. Sign in at https://www.duckdns.org, add a subdomain, copy the token.
DUCKDNS_SUBDOMAIN=                   # e.g. daha-stanford → https://daha-stanford.duckdns.org
DUCKDNS_TOKEN=                       # shown at the top of duckdns.org after you sign in; never commit it

# true: one-tap demo accounts + the demo campus (good for judges and trying it out).
# false: real @stanford.edu sign-ups only (use this for real students; see PLAN.md → "Turn demo off").
DEMO_MODE=true
