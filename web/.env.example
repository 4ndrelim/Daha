# Where the Next.js dev server proxies /api and /uploads (the FastAPI backend).
API_PROXY_TARGET=http://localhost:8000
# Which API domains use in-browser fake data: all | none | comma list of:
#   auth,users,communities,places,uploads,items,requests,transactions,
#   conversations,notifications,events,search,feed,matches,ai,scans
# Everything is live (A1–A4 and C1–C3 merged). Use a list only to work without a backend.
NEXT_PUBLIC_MOCK=none
# Shows the "Try a demo account" one-tap logins on /login.
NEXT_PUBLIC_DEMO_MODE=true
# Look of the app: holiday (red + pine green, the default) | classic (emerald + amber). Restart `make web` after changing.
NEXT_PUBLIC_THEME=holiday
